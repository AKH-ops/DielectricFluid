---
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import Chips from "../../components/Chips.astro";
import { ROWS, LINES, PROPS, FAMILY, APPS, PFAS, STATUS, PHASE, MAKERS, fmt, srcOf, pageOf, citeUrl, counts, isPublished, missing } from "../../lib/fluids";
import { SITE } from "../../lib/site";

const c = counts();
const COLS = ["boiling_point", "flash_point", "pour_point", "density", "viscosity_kin", "thermal_conductivity", "specific_heat", "dielectric_strength"];
const ALL = Object.keys(PROPS);

// Everything the client needs to filter, sort and compare, with the citation for each value.
const data = ROWS.map((r) => ({
  slug: r.slug, name: r.name, href: r.href, line: r.line.line, lineName: r.line.name,
  maker: MAKERS[r.line.maker]?.short ?? r.line.maker, family: r.line.family, phase: r.line.phase ?? "", status: r.line.status,
  pfas: r.line.pfas.status, apps: r.line.applications,
  v: Object.fromEntries(ALL.filter((k) => r.props[k]).map((k) => {
    const p = r.props[k];
    const s = srcOf(r.line, p);
    const page = pageOf(r.line, p);
    return [k, { t: fmt(p), n: p.none ? null : (p.v ?? null), at: p.at ?? "", m: p.method ?? "", pub: p.pub ?? "", u: citeUrl(p.src || r.line.source, page), s: `${s.publisher}, p.${page}` }];
  })),
}));

const fams = [...new Set(LINES.map((l) => l.family))];
const apps = [...new Set(LINES.flatMap((l) => l.applications))];
const incomplete = LINES.filter((l) => !isPublished(l));

const jsonld = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "DielectricFluid register of dielectric fluids",
  description: `Typical properties of ${c.products} dielectric fluids and grades from ${c.makers} makers, each value cited to the maker's datasheet page.`,
  url: SITE.url + "/fluids/",
  license: "https://creativecommons.org/licenses/by/4.0/",
  creator: { "@type": "Organization", name: "DielectricFluid", url: SITE.url },
  dateModified: SITE.launched,
  distribution: [
    { "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: SITE.url + "/data/fluids.csv" },
    { "@type": "DataDownload", encodingFormat: "application/json", contentUrl: SITE.url + "/data/fluids.json" },
  ],
  variableMeasured: COLS.map((k) => PROPS[k].label),
};
---
<Base title="The dielectric fluid register — properties cited to every datasheet" description={`Compare ${c.products} dielectric fluids from ${c.makers} makers on boiling and flash point, density, viscosity, thermal conductivity, specific heat and dielectric strength. Every value links to the maker's datasheet page.`} jsonld={jsonld}>
  <div class="page-head paper">
    <div class="wrap">
      <Crumbs items={[{ label: "Register" }]} />
      <h1>The dielectric fluid register</h1>
      <p class="lede">{c.products} products and grades from {c.makers} makers, with {c.values} values. Each is cited to the page of the maker's own document it came from. Filter it, sort it, and tick up to four rows to compare them side by side.</p>
    </div>
  </div>

  <section style="padding-top:2rem">
    <div class="wrap-wide">
      <div class="filters" role="search">
        <label class="sr-only" for="q">Search the register</label>
        <input id="q" type="search" placeholder="Search a product, maker or chemistry…" autocomplete="off" />
        <label class="sr-only" for="f-app">Application</label>
        <select id="f-app"><option value="">All applications</option>{apps.map((a) => <option value={a}>{APPS[a] ?? a}</option>)}</select>
        <label class="sr-only" for="f-fam">Chemistry</label>
        <select id="f-fam"><option value="">All chemistries</option>{fams.map((f) => <option value={f}>{FAMILY[f]?.label ?? f}</option>)}</select>
        <label class="sr-only" for="f-status">Status</label>
        <select id="f-status"><option value="">Any status</option>{Object.entries(STATUS).map(([k, s]) => <option value={k}>{s.label}</option>)}</select>
        <div class="seg" role="group" aria-label="PFAS">
          <button type="button" data-pfas="" aria-pressed="true">All</button>
          <button type="button" data-pfas="nofluor" aria-pressed="false">PFAS-free</button>
          <button type="button" data-pfas="pfas" aria-pressed="false">PFAS</button>
        </div>
        <span class="count" id="count" aria-live="polite"></span>
      </div>

      <div class="table-scroll">
        <table class="data" id="reg">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Compare</span></th>
              <th scope="col" data-k="name"><button type="button">Product</button></th>
              <th scope="col" data-k="family"><button type="button">Chemistry</button></th>
              <th scope="col">PFAS · status</th>
              {COLS.map((k) => <th scope="col" class="n" data-k={k}><button type="button" title={PROPS[k].label}>{PROPS[k].short}{PROPS[k].unit ? ` ${PROPS[k].unit}` : ""}</button></th>)}
            </tr>
          </thead>
          <tbody>
            {ROWS.map((r) => (
              <tr id={r.slug} data-slug={r.slug}>
                <td><input class="cmp-box" type="checkbox" aria-label={`Compare ${r.name}`} data-cmp={r.slug} /></td>
                <td class="name"><a href={r.href}>{r.name}</a><small>{MAKERS[r.line.maker]?.short}{r.use ? ` · ${r.use}` : ""}</small></td>
                <td style="white-space:nowrap">{FAMILY[r.line.family]?.label}{r.line.phase && <small style="display:block;color:var(--muted);font-size:.8rem">{PHASE[r.line.phase]}</small>}</td>
                <td><Chips line={r.line} phase={false} /></td>
                {COLS.map((k) => {
                  const p = r.props[k];
                  if (!p) return <td class="n"><span class="empty">—</span></td>;
                  const page = pageOf(r.line, p);
                  const title = [PROPS[k].label, p.at && `at ${p.at}`, p.method, p.pub && `as published: ${p.pub}`, `${srcOf(r.line, p).publisher}, p.${page}`].filter(Boolean).join(" · ");
                  return <td class="n" title={title}>{fmt(p)}<sup class="cite"><a href={citeUrl(p.src || r.line.source, page)} rel="noopener" target="_blank" aria-label={`Source for ${PROPS[k].label} of ${r.name}`}>↗</a></sup></td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="compare-bar" id="cmpbar">
        <span id="cmpcount">0 selected</span>
        <span style="display:flex;gap:.5rem">
          <button class="btn btn-ghost" type="button" id="cmpclear">Clear</button>
          <button class="btn btn-primary" type="button" id="cmpgo">Compare</button>
        </span>
      </div>
      <dialog class="compare" id="cmpdlg" aria-labelledby="cmp-h">
        <header><h2 id="cmp-h" style="font-size:1.1rem">Side-by-side comparison</h2><button class="btn btn-ghost" type="button" id="cmpclose">Close</button></header>
        <div class="body" id="cmpbody"></div>
      </dialog>

      <div class="grid grid-2" style="margin-top:2.5rem;gap:2rem">
        <div class="prose">
          <h2 style="margin-top:0;font-size:1.3rem">How to read the register</h2>
          <ul>
            <li><b>Typical values, not specifications.</b> Makers publish typical properties. The certificate of analysis that ships with a batch is the binding document.</li>
            <li><b>Conditions travel with the number.</b> Hover or tap a value to see the temperature, test method and gap. Dielectric strengths measured at different gaps (2 mm, 2.5 mm, 0.1 in) are not directly comparable.</li>
            <li><b>Converted units are flagged.</b> When a maker prints kg/m³, J/kg·K or cal/g, we convert to one unit per column and keep the printed value in the tooltip.</li>
            <li><b>"none"</b> means the maker states there is no flash point. A dash means the document does not give a value.</li>
          </ul>
        </div>
        <div class="prose">
          <h2 style="margin-top:0;font-size:1.3rem">Records still being verified</h2>
          <p>A product gets its own page only when every grade has density, viscosity, thermal conductivity, specific heat, dielectric strength and a boiling or flash point, all cited. These rows are in the table but not yet complete:</p>
          <ul>{incomplete.map((l) => <li><b>{l.name}</b> — missing {missing(l).join(", ")}.</li>)}</ul>
          <p>Coming next: Shell, Castrol and M&amp;I Materials (MIDEL) immersion and transformer fluids, and the remaining Novec and Fluorinert grades. Each goes in once its datasheet is checked. <a href="/data/">Download the data</a> under CC BY 4.0.</p>
        </div>
      </div>
    </div>
  </section>

  <script id="reg-data" type="application/json" set:html={JSON.stringify({ rows: data, props: PROPS, cols: COLS, all: ALL, pfas: PFAS, family: Object.fromEntries(Object.entries(FAMILY).map(([k, v]) => [k, v.label])) })} />
  <script>
    type V = { t: string; n: number | null; at: string; m: string; pub: string; u: string; s: string };
    type R = { slug: string; name: string; href: string; maker: string; family: string; phase: string; status: string; pfas: string; apps: string[]; lineName: string; v: Record<string, V> };
    const D = JSON.parse(document.getElementById("reg-data")!.textContent!) as { rows: R[]; props: Record<string, { label: string; short: string; unit: string }>; cols: string[]; all: string[]; pfas: Record<string, { label: string; chip: string }>; family: Record<string, string> };
    const byslug = new Map(D.rows.map((r) => [r.slug, r]));
    const tbody = document.querySelector("#reg tbody") as HTMLTableSectionElement;
    const trs = [...tbody.querySelectorAll("tr")] as HTMLTableRowElement[];
    const q = document.getElementById("q") as HTMLInputElement;
    const fApp = document.getElementById("f-app") as HTMLSelectElement;
    const fFam = document.getElementById("f-fam") as HTMLSelectElement;
    const fSt = document.getElementById("f-status") as HTMLSelectElement;
    const segs = [...document.querySelectorAll("[data-pfas]")] as HTMLButtonElement[];
    let pf = "";
    const params = new URLSearchParams(location.search);
    if (params.get("app")) fApp.value = params.get("app")!;
    if (params.get("pfas") === "free") pf = "nofluor";
    if (params.get("q")) q.value = params.get("q")!;
    segs.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.pfas === pf)));

    function apply() {
      const term = q.value.trim().toLowerCase();
      let n = 0;
      for (const tr of trs) {
        const r = byslug.get(tr.dataset.slug!)!;
        const hay = `${r.name} ${r.maker} ${r.lineName} ${D.family[r.family] ?? ""}`.toLowerCase();
        const ok = (!term || hay.includes(term)) && (!fApp.value || r.apps.includes(fApp.value)) && (!fFam.value || r.family === fFam.value) && (!fSt.value || r.status === fSt.value) &&
          (!pf || (pf === "pfas" ? r.pfas === "pfas" : r.pfas === "free" || r.pfas === "nonfluorinated"));
        tr.hidden = !ok;
        if (ok) n++;
      }
      document.getElementById("count")!.textContent = `${n} of ${trs.length} shown`;
    }
    [q, fApp, fFam, fSt].forEach((el) => el.addEventListener("input", apply));
    segs.forEach((b) => b.addEventListener("click", () => { pf = b.dataset.pfas!; segs.forEach((x) => x.setAttribute("aria-pressed", String(x === b))); apply(); }));
    apply();

    // Sorting: numbers sort numerically with blanks last; text sorts alphabetically.
    let sortK = "", dir = 1;
    for (const th of document.querySelectorAll("#reg thead th[data-k]") as NodeListOf<HTMLTableCellElement>) {
      th.querySelector("button")!.addEventListener("click", () => {
        const k = th.dataset.k!;
        dir = sortK === k ? -dir : 1; sortK = k;
        document.querySelectorAll("#reg thead th").forEach((h) => h.removeAttribute("aria-sort"));
        th.setAttribute("aria-sort", dir === 1 ? "ascending" : "descending");
        const val = (tr: HTMLTableRowElement) => { const r = byslug.get(tr.dataset.slug!)!; return k === "name" ? r.name : k === "family" ? (D.family[r.family] ?? "") : (r.v[k]?.n ?? null); };
        trs.sort((a, b) => { const x = val(a), y = val(b); if (x === null) return 1; if (y === null) return -1; return (typeof x === "number" ? (x as number) - (y as number) : String(x).localeCompare(String(y))) * dir; });
        trs.forEach((tr) => tbody.appendChild(tr));
      });
    }

    // Compare up to four.
    const picked = new Set<string>();
    const bar = document.getElementById("cmpbar")!;
    const boxes = [...document.querySelectorAll("[data-cmp]")] as HTMLInputElement[];
    const sync = () => {
      bar.classList.toggle("on", picked.size > 0);
      document.getElementById("cmpcount")!.textContent = `${picked.size} selected${picked.size >= 4 ? " (maximum)" : ""}`;
      boxes.forEach((b) => { b.disabled = !b.checked && picked.size >= 4; });
    };
    boxes.forEach((b) => b.addEventListener("change", () => { b.checked ? picked.add(b.dataset.cmp!) : picked.delete(b.dataset.cmp!); sync(); }));
    document.getElementById("cmpclear")!.addEventListener("click", () => { picked.clear(); boxes.forEach((b) => (b.checked = false)); sync(); });
    const dlg = document.getElementById("cmpdlg") as HTMLDialogElement;
    document.getElementById("cmpclose")!.addEventListener("click", () => dlg.close());
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
    document.getElementById("cmpgo")!.addEventListener("click", () => {
      const rs = [...picked].map((s) => byslug.get(s)!);
      if (rs.length < 2) { alert("Tick at least two rows to compare."); return; }
      const head = `<tr><th scope="col">Property</th>${rs.map((r) => `<th scope="col"><a href="${r.href}">${esc(r.name)}</a></th>`).join("")}</tr>`;
      const meta = `<tr><th scope="row">PFAS</th>${rs.map((r) => `<td><span class="chip ${D.pfas[r.pfas].chip}">${D.pfas[r.pfas].label}</span></td>`).join("")}</tr>` +
        `<tr><th scope="row">Chemistry</th>${rs.map((r) => `<td>${esc(D.family[r.family] ?? "")}</td>`).join("")}</tr>`;
      const body = D.all.filter((k) => rs.some((r) => r.v[k])).map((k) => `<tr><th scope="row">${D.props[k].label}${D.props[k].unit ? ` (${D.props[k].unit})` : ""}</th>${rs.map((r) => {
        const v = r.v[k];
        return v ? `<td class="n">${esc(v.t)}<sup class="cite"><a href="${v.u}" target="_blank" rel="noopener">↗</a></sup><small style="display:block;color:var(--muted);font-family:var(--font-sans)">${esc([v.at && "at " + v.at, v.m].filter(Boolean).join(" · "))}</small></td>` : `<td class="n"><span class="empty">—</span></td>`;
      }).join("")}</tr>`).join("");
      document.getElementById("cmpbody")!.innerHTML = `<table class="data"><thead>${head}</thead><tbody>${meta}${body}</tbody></table><p class="small muted" style="margin-top:1rem">Values at different temperatures or test gaps are not directly comparable. Check the condition under each value.</p>`;
      dlg.showModal();
    });
    sync();
  </script>
</Base>
