---
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import Chips from "../../components/Chips.astro";
import { LINES, MAKERS, FAMILY, isPublished, citeUrl } from "../../lib/fluids";

const makers = Object.entries(MAKERS).map(([id, m]) => ({ id, m, lines: LINES.filter((l) => l.maker === id) })).filter((x) => x.lines.length);
const href = (l: (typeof LINES)[number]) => (isPublished(l) ? `/fluids/${l.line}/` : `/fluids/#${l.grades[0].slug}`);
const queue = [
  { maker: "Shell", what: "Immersion Cooling Fluid S3 X" },
  { maker: "Castrol (bp)", what: "ON Immersion Cooling Fluid DC 15 and DC 20" },
  { maker: "M&I Materials", what: "MIDEL transformer fluids" },
  { maker: "Engineered Fluids", what: "BitCool" },
  { maker: "3M (discontinued)", what: "Novec 649, 7200, 7300, 7500; Fluorinert FC-40, FC-43, FC-3283" },
];
---
<Base title="Dielectric fluid makers — who makes what, with cited datasheets" description="The makers of immersion-cooling, transformer and heat-transfer dielectric fluids in the register, each product linked to its cited datasheet, plus the makers queued for verification.">
  <div class="page-head paper">
    <div class="wrap">
      <Crumbs items={[{ label: "Makers" }]} />
      <h1>Who makes what</h1>
      <p class="lede">The makers whose datasheets are verified in the register, and the ones next in line. Listing here is never paid for, and no maker can buy placement.</p>
    </div>
  </div>
  <section>
    <div class="wrap grid grid-2">
      {makers.map(({ id, m, lines }) => (
        <div class="card" id={id}>
          <h2 style="font-size:1.25rem">{m.name}</h2>
          <p class="small muted" style="margin-top:.25rem">{m.where} · <a href={m.url} rel="noopener" target="_blank">website</a></p>
          {m.note && <p class="small" style="margin-top:.6rem">{m.note}<sup class="cite"><a href={citeUrl("3m-exit-release")} target="_blank" rel="noopener">↗</a></sup></p>}
          <ul style="list-style:none;padding:0;margin-top:1rem;display:grid;gap:.7rem">
            {lines.map((l) => (
              <li style="display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:.7rem">
                <span><a href={href(l)}><b>{l.name}</b></a><br /><span class="small muted">{FAMILY[l.family].label} · {l.grades.length} grade{l.grades.length > 1 ? "s" : ""}</span></span>
                <Chips line={l} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="wrap" style="margin-top:2.5rem">
      <div class="card">
        <span class="eyebrow">Verification queue</span>
        <h2 style="font-size:1.25rem;margin-top:.5rem">Next datasheets to verify</h2>
        <p class="muted small" style="margin-top:.4rem">These go into the register only once their maker's own document is checked, value by value.</p>
        <ul style="margin-top:1rem;padding-left:1.2rem;display:grid;gap:.4rem">{queue.map((q) => <li><b>{q.maker}</b> — {q.what}</li>)}</ul>
        <p class="small" style="margin-top:1rem">A maker, or want us to add a fluid? Email <a href="mailto:hello@dielectricfluid.com">hello@dielectricfluid.com</a> with a link to its datasheet.</p>
      </div>
    </div>
  </section>
</Base>
