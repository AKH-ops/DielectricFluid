---
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import { SITE } from "../../lib/site";
// Turnstile is optional (worker/index.js verifies it only when TURNSTILE_SECRET is set). Public by design.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || SITE.turnstileSiteKey;
// The values must match CHOICES in worker/index.js.
const applications = [
  ["data-centre-single-phase", "Data centre: single-phase immersion"],
  ["data-centre-two-phase", "Data centre: two-phase immersion"],
  ["ev-battery", "EV battery or e-drive"],
  ["transformer", "Transformer"],
  ["power-electronics", "Power electronics"],
  ["semiconductor", "Semiconductor tools"],
  ["test-cleaning", "Test, cleaning or heat transfer"],
  ["other", "Other"],
];
const pfasOptions = [["must-be-free", "Must be PFAS-free"], ["prefer-free", "Prefer PFAS-free"], ["no-constraint", "No constraint"], ["not-sure", "Not sure"]];
const timelines = [["now", "Needed now"], ["1-3-months", "1–3 months"], ["3-12-months", "3–12 months"], ["researching", "Researching"]];
const faq = [
  { q: "What does it cost?", a: "Nothing for buyers. If an introduction leads to business, the supplier may pay us a referral fee. We tell you before you decide, and it never changes what the register shows." },
  { q: "Will you share my details?", a: "Only if you say yes on the form. You can ask us to answer your questions without contacting any supplier, and we will." },
  { q: "Where does my request go?", a: "It is stored in our own Cloudflare account and emailed to the desk. No outside form service handles it." },
  { q: "Who will I hear from?", a: "From us, at the address you give, replying to your request. We do not add you to mailing lists." },
  { q: "What should I not send?", a: "Confidential specifications or sensitive personal data. A description of the application, volume and constraints is enough to start." },
];
const jsonld = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---
<Base title="The sourcing desk — tell us what you are cooling, we find the supply" description="Send your application, volume, PFAS constraint and the fluid you are replacing. We shortlist fluids from the cited register and come back with options and quotes. Free for buyers." jsonld={jsonld}>
  <div class="page-head paper">
    <div class="wrap">
      <Crumbs items={[{ label: "Desk" }]} />
      <h1>Tell us what you are cooling. We find the supply.</h1>
      <p class="lede">Replacing a discontinued 3M fluid, filling a new immersion tank, or re-specifying a transformer fluid? Send the essentials. We shortlist from the register, go to the makers and distributors that fit, and come back with options you can check.</p>
    </div>
  </div>
  <section style="padding-top:2.25rem">
    <div class="wrap article-grid" style="padding-top:0">
      <div>
        <form id="desk-form" class="desk-form card" method="post" action="/api/desk">
          <div class="form-grid">
            <label class="field"><span>Your name <i aria-hidden="true">*</i></span><input name="name" required maxlength="120" autocomplete="name" /></label>
            <label class="field"><span>Work email <i aria-hidden="true">*</i></span><input name="email" type="email" required maxlength="200" autocomplete="email" /></label>
            <label class="field"><span>Company</span><input name="company" maxlength="160" autocomplete="organization" /></label>
            <label class="field"><span>Country the fluid is for</span><input name="country" maxlength="80" autocomplete="country-name" /></label>
            <label class="field span-2"><span>Application <i aria-hidden="true">*</i></span>
              <select name="application" required><option value="">Choose…</option>{applications.map(([v, l]) => <option value={v}>{l}</option>)}</select>
            </label>
            <label class="field span-2"><span>Fluid you use now or are replacing</span><input name="replacing" maxlength="160" placeholder="e.g. Novec 7100, FC-72, mineral transformer oil" /></label>
            <label class="field"><span>Volume</span><input name="volume" maxlength="120" placeholder="e.g. 2,000 L first fill" /></label>
            <label class="field"><span>PFAS constraint</span>
              <select name="pfas"><option value="">Choose…</option>{pfasOptions.map(([v, l]) => <option value={v}>{l}</option>)}</select>
            </label>
            <label class="field"><span>Timeline</span>
              <select name="timeline"><option value="">Choose…</option>{timelines.map(([v, l]) => <option value={v}>{l}</option>)}</select>
            </label>
            <label class="field span-2"><span>What should we know?</span><textarea name="message" rows="5" maxlength="4000" placeholder="Equipment or tank, operating temperatures, materials, standards (IEC 62770, OCP…), quantities over time."></textarea></label>
          </div>
          <fieldset class="choice">
            <legend>May we contact suppliers for you? <i aria-hidden="true">*</i></legend>
            <label><input type="radio" name="share" value="yes" required /> <span><b>Yes</b>: share my request with suppliers that fit, to get quotes</span></label>
            <label><input type="radio" name="share" value="no" /> <span><b>No</b>: just answer my questions</span></label>
          </fieldset>
          <label class="check"><input type="checkbox" name="privacy" value="yes" required /> <span>I have read the <a href="/privacy/">privacy policy</a> and I am not sending confidential specifications.</span></label>
          <div class="hp" aria-hidden="true"><label>Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label></div>
          <input type="hidden" name="fluid" /><input type="hidden" name="source" /><input type="hidden" name="phase" /><input type="hidden" name="elapsed" />
          {siteKey && (
            <>
              <div class="cf-turnstile" id="desk-check" data-sitekey={siteKey} data-theme="auto" data-size="flexible"></div>
              <script is:inline>
                // Follow the site's own theme switch, not just the OS setting. Runs before Turnstile's script loads below.
                (function () { var t = document.documentElement.dataset.theme; if (t) document.getElementById("desk-check").setAttribute("data-theme", t); })();
              </script>
            </>
          )}
          <div class="form-foot">
            <button class="btn btn-primary" type="submit">Send to the desk <span class="arrow">→</span></button>
            <p id="desk-status" class="form-status" role="status" aria-live="polite"></p>
          </div>
          <noscript><p class="small">The form needs JavaScript for its spam check. Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> instead.</p></noscript>
        </form>
        <div id="desk-sent" class="card desk-sent" hidden tabindex="-1">
          <h2>Request received</h2>
          <p>Thank you. We reply by email to the address you gave. If you said yes to supplier contact, we tell you which suppliers we approach before we do.</p>
          <p><a class="btn btn-ghost" href="/fluids/">Browse the register <span class="arrow">→</span></a></p>
        </div>
        <p class="small muted" style="margin-top:.8rem">Prefer email? <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. Please do not send confidential specifications or sensitive personal data. See our <a href="/privacy/">privacy policy</a>.</p>
      </div>
      <aside>
        <ol class="steps" style="grid-template-columns:1fr">
          <li><b>You send the essentials</b><span>Application, fill volume, the fluid you are replacing, PFAS constraint, timeline.</span></li>
          <li><b>We shortlist</b><span>Only fluids whose datasheets fit, every value cited.</span></li>
          <li><b>We ask the makers</b><span>Price, lead time, minimum order and warranty notes, with your agreement.</span></li>
          <li><b>You decide</b><span>A side-by-side answer for your team. No obligation.</span></li>
        </ol>
      </aside>
    </div>
    <div class="wrap-narrow prose" style="margin-top:1rem">
      <h2>Questions</h2>
      <div class="faq">{faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>
  {siteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script is:inline define:vars={{ email: SITE.email }}>
    // Context from the finder or a product page (?replacing=Novec%207100&source=novec-finder, ?fluid=…) fills the form;
    // submission goes to /api/desk (worker/index.js) and the answer is shown in place.
    (function () {
      var t0 = Date.now();
      var form = document.getElementById("desk-form"), status = document.getElementById("desk-status"), sent = document.getElementById("desk-sent");
      var p = new URLSearchParams(location.search);
      function set(n, v) { var el = form.elements[n]; if (el && v && !el.value) el.value = v.slice(0, 160); }
      set("replacing", p.get("replacing")); set("fluid", p.get("fluid")); set("source", p.get("source")); set("phase", p.get("phase"));
      ["application", "pfas"].forEach(function (n) {
        var v = p.get(n), el = form.elements[n];
        if (v && el && Array.prototype.some.call(el.options, function (o) { return o.value === v; })) el.value = v;
      });
      var MSG = {
        check: "Our spam check stopped this request. Please wait a few seconds and send it again.",
        fields: "Please check the marked fields.",
        message: "Tell us the fluid you are replacing, or describe what you need.",
        server: "Something went wrong on our side and your request was not saved. Please email " + email + ".",
      };
      function done() { form.hidden = true; sent.hidden = false; sent.focus(); }
      if (p.get("sent") === "1") done();
      else if (p.get("error")) status.textContent = MSG[p.get("error")] || MSG.server;
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        Array.prototype.forEach.call(form.querySelectorAll("[aria-invalid]"), function (el) { el.removeAttribute("aria-invalid"); });
        if (!form.elements.message.value.trim() && !form.elements.replacing.value.trim()) {
          status.textContent = MSG.message; form.elements.message.setAttribute("aria-invalid", "true"); form.elements.message.focus(); return;
        }
        form.elements.elapsed.value = String(Date.now() - t0);
        var btn = form.querySelector("button[type=submit]");
        btn.disabled = true; status.textContent = "Sending…";
        fetch(form.action, { method: "POST", body: new FormData(form), headers: { accept: "application/json" } })
          .then(function (r) { return r.json().catch(function () { return { ok: false, error: "server" }; }); })
          .then(function (j) {
            if (j.ok) return done();
            status.textContent = MSG[j.error] || MSG.server;
            (j.fields || []).forEach(function (n) { var el = form.elements[n]; if (el && el.setAttribute) el.setAttribute("aria-invalid", "true"); });
            if (window.turnstile) window.turnstile.reset();
          })
          .catch(function () { status.textContent = MSG.server; })
          .finally(function () { btn.disabled = false; });
      });
    })();
  </script>
</Base>
