---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import SourceList from "../components/SourceList.astro";
import { SITE } from "../lib/site";

export async function getStaticPaths() {
  const all = await getCollection("guides");
  return all.map((entry) => ({ params: { path: entry.data.path }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const srcIds = [...new Set([...(entry.body ?? "").matchAll(/\{\{src:([a-z0-9-]+)/g)].map((m) => m[1]))];
const related = d.related.map((p) => all.find((e) => e.data.path === p)).filter(Boolean);
const isGuide = d.kind === "guide";
const updated = d.updated.toISOString().slice(0, 10);
const parent = d.path.startsWith("applications/") ? [{ href: "/guides/", label: "Guides" }] : isGuide ? [{ href: "/guides/", label: "Guides" }] : [];
const jsonld = isGuide
  ? { "@context": "https://schema.org", "@type": "TechArticle", headline: d.h1 ?? d.title, description: d.description, dateModified: updated, datePublished: SITE.launched, author: { "@type": "Person", name: SITE.author }, publisher: { "@type": "Organization", name: "DielectricFluid", url: SITE.url }, mainEntityOfPage: `${SITE.url}/${d.path}/` }
  : undefined;
---
<Base title={d.title} description={d.description} type={isGuide ? "article" : "website"} jsonld={jsonld}>
  <div class="page-head paper">
    <div class="wrap">
      <Crumbs items={[...parent, { label: d.eyebrow ?? d.title }]} />
      <h1>{d.h1 ?? d.title}</h1>
      {d.answer && (
        <div class="answer" style="max-width:820px">
          <span class="label">The short answer</span>
          <p>{d.answer}</p>
        </div>
      )}
      {isGuide && (
        <p class="byline">
          <span>By <a href="/about/">{SITE.author}</a></span>
          <span>Updated <time datetime={updated}>{updated}</time></span>
          <span>{srcIds.length} sources, every claim linked</span>
        </p>
      )}
    </div>
  </div>
  <div class="wrap article-grid">
    <article class="prose">
      <Content />
      {srcIds.length > 0 && <SourceList ids={srcIds} />}
      {isGuide && (
        <p class="small muted" style="margin-top:2rem">General information, not engineering, safety or legal advice. Check values against the current datasheet and certificate of analysis, and validate any fluid in your own system. <a href="/disclaimer/">Disclaimer</a></p>
      )}
    </article>
    <aside class="toc">
      {toc.length > 1 && (
        <>
          <span class="eyebrow">On this page</span>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </>
      )}
      {related.length > 0 && (
        <div style="margin-top:1.75rem">
          <span class="eyebrow">Related</span>
          <ol>{related.map((r) => <li><a href={`/${r!.data.path}/`}>{r!.data.eyebrow ?? r!.data.title}</a></li>)}</ol>
        </div>
      )}
      <a class="btn btn-primary" style="margin-top:1.75rem;width:100%;justify-content:center" href="/desk/">Ask the desk →</a>
    </aside>
  </div>
</Base>
