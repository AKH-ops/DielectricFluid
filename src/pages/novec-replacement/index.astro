---
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import SourceList from "../../components/SourceList.astro";
import { LINES, ROWS, MAKERS, FAMILY, PFAS, STATUS, fmt, citeUrl } from "../../lib/fluids";
import disc from "../../data/discontinued.json";

// Everything the finder needs, computed at build time from verified records only.
const lineOf = (id?: string) => LINES.find((l) => l.line === id);
const grades = disc.grades.filter((g) => !g.note).map((g) => {
  const l = lineOf(g.line);
  const p = l?.grades[0].props;
  return { id: g.id, name: g.name, verified: !!l, href: l ? `/fluids/${l.line}/` : null, bp: p?.boiling_point?.v ?? null, ds: p ? fmt(p.dielectric_strength) : "", family: l ? FAMILY[l.family].label : "" };
});
const cands = ROWS.filter((r) => r.line.status !== "discontinued").map((r) => ({
  name: r.name, href: r.href, maker: MAKERS[r.line.maker].short, family: FAMILY[r.line.family].label, status: r.line.status,
  pfas: r.line.pfas.status, bp: r.props.boiling_point?.v ?? null, flash: r.props.flash_point ? fmt(r.props.flash_point) : "", ds: fmt(r.props.dielectric_strength),
}));
const verifiedCount = grades.filter((g) => g.verified).length;
// PFAS-free options, one entry per product line, with the flash-point range across its grades.
const freeLines = LINES.filter((l) => (l.pfas.status === "free" || l.pfas.status === "nonfluorinated") && l.status === "active").map((l) => {
  const fl = l.grades.map((g) => g.props.flash_point).filter((p) => p && p.v !== undefined);
  const vs = fl.map((p) => p!.v as number);
  const approx = fl.some((p) => p!.q === "≈") ? "≈ " : "";
  return { name: l.name.replace(/[™®]/g, ""), href: l.published_on ? `/fluids/${l.line}/` : `/fluids/#${l.grades[0].slug}`, maker: MAKERS[l.maker].short, family: FAMILY[l.family].label, grades: l.grades.length, pfas: l.pfas.status, status: l.status,
    flash: vs.length ? approx + (Math.min(...vs) === Math.max(...vs) ? `${vs[0]}` : `${Math.min(...vs)}–${Math.max(...vs)}`) : "" };
});

const faq = [
  { q: "Is there a drop-in replacement for Novec 7100 or FC-72?", a: "Some fluorinated fluids have boiling points within a few degrees of the 3M grades. The finder above shows the closest ones in the register. A different chemistry is still a different fluid, so check dielectric strength, material compatibility and your system's operating range, and plan to requalify." },
  { q: "Are the replacements PFAS-free?", a: "The close boiling-point matches in the register are mostly fluorinated, and several meet the OECD structural definition of PFAS. The PFAS-free fluids here are single-phase hydrocarbons and esters, and they usually mean a change of system design rather than a drop-in." },
  { q: "My grade has no verified data yet. What now?", a: "Send it to the desk. We match it by hand against the maker datasheets we hold, and add it to the register once 3M's own sheet for that grade is verified." },
];
const jsonld = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---
<Base title="Novec & Fluorinert replacement finder — matched on verified datasheets" description="3M listed every Novec engineered fluid and Fluorinert liquid in its PFAS manufacturing exit. Pick your grade and see the closest verified replacements by boiling point, with PFAS status and status shown, every value cited." jsonld={jsonld}>
  <div class="page-head paper">
    <div class="wrap">
      <Crumbs items={[{ label: "Novec replacement" }]} />
      <h1>Novec &amp; Fluorinert replacement finder</h1>
      <div class="answer" style="max-width:820px">
        <span class="label">The short answer</span>
        <p>3M named its Novec engineered fluids and Fluorinert electronic liquids among the products impacted by its exit from PFAS manufacturing by the end of 2025.<sup class="cite"><a href={citeUrl("3m-exit-letter", 2)} target="_blank" rel="noopener">↗</a></sup> Replacing one is a two-way choice: a <b>close fluorinated match</b> that keeps your system and may keep the PFAS question, or a <b>PFAS-free fluid</b> that usually means a single-phase redesign. Pick your grade to see both, matched on maker datasheets.</p>
      </div>
    </div>
  </div>

  <section style="padding-top:2.25rem">
    <div class="wrap">
      <div class="finder">
        <div class="row">
          <div>
            <label for="grade">Which 3M fluid are you replacing?</label>
            <select id="grade">
              <option value="">Choose a grade…</option>
              <optgroup label="Verified 3M datasheet in the register">
                {grades.filter((g) => g.verified).map((g) => <option value={g.id}>{g.name}</option>)}
              </optgroup>
              <optgroup label="Listed by 3M as impacted — datasheet not yet verified here">
                {grades.filter((g) => !g.verified).map((g) => <option value={g.id}>{g.name}</option>)}
              </optgroup>
            </select>
          </div>
          <a class="btn btn-primary" id="deskbtn" href="/desk/?source=novec-finder">Get quotes from the desk <span class="arrow">→</span></a>
        </div>
        <div id="out" style="margin-top:1.5rem" aria-live="polite">
          <p class="muted">{grades.length} discontinued 3M grades are listed, {verifiedCount} of them with 3M's own datasheet verified in the register. Choose one to see the closest verified alternatives.</p>
        </div>
      </div>

      <div class="article-grid">
        <div class="prose">
          <h2 style="margin-top:0">Two honest paths</h2>
          <h3>1. A close fluorinated match</h3>
          <p>A fluid whose boiling point, density and dielectric strength sit near the 3M grade can keep a two-phase or vapour-phase system running with the least redesign. In this register those candidates are perfluoropolyethers (Galden HT) and a developmental hydrofluoroolefin (Opteon 2P50). The Galden grades meet the OECD structural definition of PFAS.<sup class="cite"><a href="/fluids/galden-ht/">↗</a></sup> Opteon 2P50's structure is not disclosed, so its PFAS status is undetermined here.<sup class="cite"><a href="/fluids/opteon-2p50/">↗</a></sup> A match like this solves supply. It may not solve the regulatory question if you are exposed to the EU restriction now in progress (see the <a href="/pfas/">PFAS tracker</a>).</p>
          <h3>2. Leave fluorinated chemistry</h3>
          <p>The PFAS-free fluids in the register are synthetic hydrocarbons and esters, with flash points from 157 °C (ElectroCool EC-122) to about 330 °C (Envirotemp FR3).<sup class="cite"><a href="/fluids/?pfas=free">↗</a></sup> They are single-phase coolants: they do not boil in service. Moving to one usually means a pumped single-phase design, but it takes the PFAS question off the table for the life of the system. See <a href="/single-vs-two-phase/">single-phase vs two-phase</a>.</p>
          <h2>What to check before you switch</h2>
          <ul>
            <li><b>Boiling point and liquid range</b> against your operating temperatures. Two-phase and vapour-phase systems are designed around the boiling point.</li>
            <li><b>Dielectric strength at the same test gap.</b> 3M quotes a 0.1 in (2.54 mm) gap; other makers use 2 mm or 2.5 mm.</li>
            <li><b>Material compatibility</b> with your seals, plastics and coatings. Ask the maker for data on your materials.</li>
            <li><b>Requalification.</b> Any change of chemistry means re-testing in your system. Budget the time before your remaining stock runs out.</li>
          </ul>
          <h2>Frequently asked</h2>
          <div class="faq">{faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
          <SourceList ids={["3m-exit-release", "3m-exit-letter", "3m-novec7000-tds", "3m-novec7100-pi", "3m-fc72-tds", "3m-fc770-tds", "syensqo-galden-ht", "chemours-2p50-pis", "oecd-2021-terminology"]} />
        </div>
        <aside class="toc">
          <span class="eyebrow">On this page</span>
          <ol><li><a href="#grade">Finder</a></li><li><a href="#main">Two paths</a></li><li><a href="#sources">Sources</a></li></ol>
          <p class="small muted" style="margin-top:1.25rem">Not affiliated with 3M. Novec™ and Fluorinert™ are trademarks of 3M, named here only to identify the products being replaced.</p>
        </aside>
      </div>
    </div>
  </section>

  <script id="finder-data" type="application/json" set:html={JSON.stringify({ grades, cands, freeLines, pfas: PFAS, status: STATUS })} />
  <script>
    type G = { id: string; name: string; verified: boolean; href: string | null; bp: number | null; ds: string; family: string };
    type C = { name: string; href: string; maker: string; family: string; status: string; pfas: string; bp: number | null; flash: string; ds: string; grades?: number };
    const D = JSON.parse(document.getElementById("finder-data")!.textContent!) as { grades: G[]; cands: C[]; freeLines: C[]; pfas: Record<string, { label: string; chip: string }>; status: Record<string, { label: string; chip: string }> };
    const sel = document.getElementById("grade") as HTMLSelectElement;
    const out = document.getElementById("out")!;
    const desk = document.getElementById("deskbtn") as HTMLAnchorElement;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
    const chip = (c: C) => `<span class="chip ${D.pfas[c.pfas].chip}">${D.pfas[c.pfas].label}</span>${c.status !== "active" ? ` <span class="chip ${D.status[c.status].chip}">${D.status[c.status].label}</span>` : ""}`;
    function render() {
      const g = D.grades.find((x) => x.id === sel.value);
      desk.href = `/desk/?source=novec-finder${g ? "&replacing=" + encodeURIComponent(g.name) : ""}`;
      history.replaceState(null, "", g ? `?grade=${g.id}` : location.pathname);
      if (!g) { out.innerHTML = ""; return; }
      if (!g.verified || g.bp === null) {
        out.innerHTML = `<div class="callout"><p><b>${esc(g.name)}</b> is on 3M's list of impacted products, but we have not yet verified 3M's own datasheet for it, so we will not guess its properties.</p><p style="margin-top:.6rem">Send it to the desk. We match it by hand against the datasheets we hold and reply with options.</p><p style="margin-top:.9rem"><a class="btn btn-primary" href="${desk.href}">Match ${esc(g.name)} by hand →</a></p></div>`;
        return;
      }
      const bp = g.bp;
      const near = D.cands.filter((c) => c.bp !== null).map((c) => ({ c, d: (c.bp as number) - bp })).sort((a, b) => Math.abs(a.d) - Math.abs(b.d)).slice(0, 5);
      const max = Math.max(...near.map((n) => Math.abs(n.d)), 1);
      const free = D.freeLines;
      out.innerHTML =
        `<div class="callout" style="margin-bottom:1.25rem"><b><a href="${g.href}">${esc(g.name)}</a></b> — ${esc(g.family)}, boiling point <b class="num">${bp} °C</b>${g.ds ? `, dielectric strength <b class="num">${esc(g.ds)} kV</b> (0.1 in gap)` : ""}. Discontinued; PFAS.</div>` +
        `<h3 style="font-size:1.05rem;margin-bottom:.6rem">Closest boiling points</h3>` +
        near.map(({ c, d }) => `<div class="match"><div><a href="${c.href}"><b>${esc(c.name)}</b></a> <span class="muted small">· ${esc(c.maker)} · ${esc(c.family)}</span><div class="meta">${chip(c)}${c.ds ? `<span class="chip chip-plain">${esc(c.ds)} kV</span>` : ""}</div></div><div class="delta"><span class="num">${c.bp} °C</span><br><span class="muted">${d === 0 ? "same" : (d > 0 ? "+" : "−") + Math.abs(Math.round(d * 10) / 10) + " °C"}</span></div><div class="meter"><i style="width:${Math.max(6, 100 - (Math.abs(d) / max) * 90)}%"></i></div></div>`).join("") +
        `<h3 style="font-size:1.05rem;margin:1.5rem 0 .6rem">PFAS-free, single-phase (a change of architecture)</h3>` +
        `<p class="small muted" style="margin-bottom:.6rem">These do not boil in use, so they are not drop-ins for two-phase systems.</p>` +
        free.map((c) => `<div class="match"><div><a href="${c.href}"><b>${esc(c.name)}</b></a> <span class="muted small">· ${esc(c.maker)} · ${esc(c.family)}${c.grades && c.grades > 1 ? ` · ${c.grades} grades` : ""}</span><div class="meta">${chip(c)}</div></div><div class="delta">flash<br><span class="num">${esc(c.flash)} °C</span></div></div>`).join("");
    }
    sel.addEventListener("change", render);
    const pre = new URLSearchParams(location.search).get("grade");
    if (pre && D.grades.some((g) => g.id === pre)) { sel.value = pre; render(); }
  </script>
</Base>
